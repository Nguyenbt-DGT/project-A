  "nodes": {
    "node_paste_cbbc2cde5f4d": {
      "type": "variant",
      "id": "node_paste_cbbc2cde5f4d",
      "label": "Little Orrery",
      "html": "<style>\n  :root{\n    --night:#16183A; --paper:#F4ECDA; --ink:#1A1B33; --cream:#F6EFE0;\n    --tangerine:#FF6A2B; --aqua:#1FB6C4; --marigold:#F4B92E;\n    --ease:cubic-bezier(.16,.84,.44,1);\n    --spring:cubic-bezier(.34,1.56,.64,1);\n  }\n  *{box-sizing:border-box;margin:0;padding:0}\n  html{scroll-behavior:smooth}\n  body{\n    font-family:'Quicksand',sans-serif; background:var(--paper); color:var(--ink);\n    line-height:1.6; overflow-x:hidden; -webkit-font-smoothing:antialiased;\n  }\n  .disp{font-family:'Fredoka',sans-serif;}\n  /* painted paper texture */\n  .paper-tex{\n    background-color:var(--paper);\n    background-image:\n      radial-gradient(circle at 18% 28%, rgba(244,185,46,.05) 0%, transparent 42%),\n      radial-gradient(circle at 82% 72%, rgba(31,182,196,.05) 0%, transparent 42%),\n      radial-gradient(circle at 50% 50%, rgba(255,106,43,.035) 0%, transparent 55%);\n  }\n  .night-tex{\n    background-color:var(--night);\n    background-image:\n      radial-gradient(circle at 15% 22%, rgba(244,185,46,.07) 0%, transparent 38%),\n      radial-gradient(circle at 85% 78%, rgba(31,182,196,.08) 0%, transparent 40%),\n      radial-gradient(circle at 60% 40%, rgba(255,106,43,.05) 0%, transparent 50%);\n  }\n  .wrap{max-width:1240px;margin:0 auto;padding:0 32px}\n  .eyebrow{font-family:'Fredoka',sans-serif;font-weight:500;text-transform:uppercase;\n    letter-spacing:.28em;font-size:.72rem;}\n  a{color:inherit;text-decoration:none}\n  button{font-family:inherit;cursor:pointer;border:none}\n  /* cinematic plaque buttons — squared, engraved gold keyline, uppercase */\n  .btn-primary{display:inline-flex;align-items:center;justify-content:center;gap:9px;\n    background:var(--tangerine);color:var(--cream);font-family:'Fredoka',sans-serif;\n    font-weight:600;text-transform:uppercase;letter-spacing:.14em;font-size:.78rem;\n    padding:14px 26px;border-radius:5px;\n    box-shadow:inset 0 0 0 1.5px rgba(244,185,46,.7), 0 10px 26px rgba(255,106,43,.3);\n    transition:transform .35s var(--ease),background .35s var(--ease),box-shadow .35s var(--ease);}\n  .btn-primary:hover{background:#ec5a1d;transform:translateY(-3px);\n    box-shadow:inset 0 0 0 1.5px var(--marigold), 0 14px 34px rgba(255,106,43,.45);}\n  .btn-primary:focus-visible,.btn-text:focus-visible,a:focus-visible,input:focus-visible{\n    outline:3px solid var(--aqua);outline-offset:3px}\n  .btn-text{display:inline-flex;align-items:center;gap:10px;background:none;color:inherit;\n    font-family:'Fredoka',sans-serif;font-weight:600;text-transform:uppercase;letter-spacing:.14em;font-size:.74rem;\n    padding:13px 22px;border-radius:5px;box-shadow:inset 0 0 0 1px currentColor;\n    transition:transform .35s var(--ease),background .35s var(--ease),box-shadow .35s var(--ease);}\n  .btn-text:hover{transform:translateY(-3px);box-shadow:inset 0 0 0 1px var(--marigold)}\n  .star{display:inline-block;width:1em;height:1em;background:var(--marigold);\n    clip-path:polygon(50% 0%,61% 35%,98% 35%,68% 57%,79% 91%,50% 70%,21% 91%,32% 57%,2% 35%,39% 35%)}\n\n  /* NAV */\n  nav.bar{display:flex;align-items:center;justify-content:space-between;padding:22px 0;position:relative;z-index:50}\n  .logo-dot{width:38px;height:38px;border-radius:50%;background:var(--night);position:relative;flex:0 0 auto}\n  .logo-dot i{position:absolute;border-radius:50%}\n  .logo-dot .d1{width:8px;height:8px;background:var(--marigold);top:6px;left:8px}\n  .logo-dot .d2{width:5px;height:5px;background:var(--cream);bottom:8px;right:8px}\n  .logo-dot .d3{width:6px;height:6px;background:var(--tangerine);top:12px;right:7px}\n  .brandrow{display:flex;align-items:center;gap:12px}\n  .brandname{font-family:'Fredoka',sans-serif;font-weight:700;font-size:1.5rem;letter-spacing:-.01em}\n  .brandtag{font-size:.72rem;color:rgba(26,27,51,.6);font-style:italic;max-width:160px;line-height:1.3}\n  .navlinks{display:flex;gap:28px;font-weight:500;font-size:.92rem}\n  .navlinks a:hover{color:var(--tangerine)}\n  .navright{display:flex;align-items:center;gap:14px}\n  .signin{background:none;font-weight:500;font-size:.92rem}\n\n  /* HERO — looping cosmos video (Mode B) */\n  .hero{position:relative;min-height:100svh;display:flex;flex-direction:column;justify-content:center;\n    overflow:hidden;background:var(--night);color:var(--cream);isolation:isolate}\n  /* layer 0: CSS cosmos fallback (shows until/if hero.mp4 + hero.png exist) */\n  .hero-sky{position:absolute;inset:0;z-index:0;\n    background:\n      radial-gradient(ellipse 80% 60% at 72% 16%, rgba(31,182,196,.20), transparent 60%),\n      radial-gradient(ellipse 75% 55% at 20% 82%, rgba(255,106,43,.18), transparent 62%),\n      radial-gradient(circle at 50% 42%, #1e2356 0%, var(--night) 72%)}\n  .hero-sky::before{content:\"\";position:absolute;inset:0;animation:twinkle 6s ease-in-out infinite;\n    background-repeat:no-repeat;background-image:\n      radial-gradient(1.6px 1.6px at 18% 28%, rgba(246,239,224,.95), transparent),\n      radial-gradient(1.2px 1.2px at 64% 20%, rgba(246,239,224,.7), transparent),\n      radial-gradient(1.6px 1.6px at 82% 58%, rgba(244,185,46,.85), transparent),\n      radial-gradient(1.1px 1.1px at 38% 70%, rgba(246,239,224,.6), transparent),\n      radial-gradient(1.1px 1.1px at 11% 78%, rgba(246,239,224,.55), transparent),\n      radial-gradient(1.6px 1.6px at 90% 33%, rgba(246,239,224,.75), transparent),\n      radial-gradient(1.2px 1.2px at 54% 48%, rgba(31,182,196,.75), transparent),\n      radial-gradient(1.1px 1.1px at 30% 14%, rgba(246,239,224,.5), transparent),\n      radial-gradient(1.3px 1.3px at 74% 80%, rgba(246,239,224,.6), transparent)}\n  @keyframes twinkle{0%,100%{opacity:.5}50%{opacity:1}}\n  /* revolving planets */\n  .hero-orbit{position:absolute;z-index:0;top:48%;left:50%;width:min(128vh,1180px);aspect-ratio:1;\n    transform:translate(-50%,-50%);pointer-events:none}\n  .hero-orbit .ring{position:absolute;top:50%;left:50%;border-radius:50%;transform:translate(-50%,-50%);\n    border:1px solid rgba(246,239,224,.09)}\n  .hero-orbit .r1{width:100%;height:100%;animation:spin 64s linear infinite}\n  .hero-orbit .r2{width:68%;height:68%;border-color:rgba(31,182,196,.14);animation:spin 44s linear infinite reverse}\n  .hero-orbit .r3{width:40%;height:40%;border-color:rgba(244,185,46,.14);animation:spin 30s linear infinite}\n  .hero-orbit .planet{position:absolute;top:-9px;left:50%;width:18px;height:18px;border-radius:50%;transform:translateX(-50%)}\n  .hero-orbit .p1{background:radial-gradient(circle at 34% 30%, #6675f4, var(--ultramarine,#1B34D8) 72%);box-shadow:0 0 18px rgba(31,182,196,.45)}\n  .hero-orbit .p2{width:13px;height:13px;top:-7px;background:radial-gradient(circle at 34% 30%, var(--aqua), #0c7681 72%);box-shadow:0 0 14px rgba(31,182,196,.5)}\n  .hero-orbit .p3{width:11px;height:11px;top:-6px;background:radial-gradient(circle at 34% 30%, var(--marigold), #ad7a11 72%);box-shadow:0 0 13px rgba(244,185,46,.55)}\n  @keyframes spin{to{transform:translate(-50%,-50%) rotate(360deg)}}\n  /* layer 1: the video */\n  .hero-video{position:absolute;inset:0;z-index:1;width:100%;height:100%;object-fit:cover;\n    opacity:0;transition:opacity 1.2s var(--ease)}\n  .hero-video.ready{opacity:1}\n  /* layer 2: center-weighted legibility scrim — tames the busy painted\n     cosmos behind the text while keeping the corner planets vivid */\n  .hero-scrim{position:absolute;inset:0;z-index:2;pointer-events:none;\n    background:\n      radial-gradient(ellipse 70% 74% at 50% 50%, rgba(22,24,58,.66) 0%, rgba(22,24,58,.28) 52%, rgba(22,24,58,.08) 78%),\n      linear-gradient(to bottom, rgba(22,24,58,.5) 0%, rgba(22,24,58,.2) 26%, rgba(22,24,58,.2) 60%, rgba(22,24,58,.66) 100%)}\n  /* layer 3: content — center aligned */\n  .hero-inner{position:relative;z-index:3;padding-top:96px;padding-bottom:24px;text-align:center}\n  .hero-eyebrow{color:var(--aqua);margin-bottom:20px;letter-spacing:.34em}\n  .hero-h1{font-family:'Cinzel Decorative','Cinzel',serif;font-weight:700;font-size:clamp(1.9rem,5vw,4.3rem);\n    line-height:1.16;letter-spacing:.012em;max-width:17ch;margin:0 auto;text-shadow:0 2px 30px rgba(22,24,58,.6)}\n  .hero-h1 .ln{display:block;overflow:hidden;padding-bottom:.08em}\n  .hero-h1 .ln>span{display:block;transform:translateY(116%);transform-origin:center top;\n    transition:transform 1s var(--ease)}\n  .hero-h1 .ln:nth-child(2)>span{transition-delay:.12s}\n  .hero.is-in .hero-h1 .ln>span{transform:translateY(0)}\n  .hero-h1 .tang{color:var(--tangerine);font-style:normal}\n  .hero-sub{margin:24px auto 0;max-width:46ch;font-size:clamp(1rem,1.4vw,1.18rem);color:var(--cream);opacity:.92;text-shadow:0 1px 14px rgba(22,24,58,.6)}\n  .hero-ctas{margin-top:36px;display:flex;align-items:stretch;justify-content:center;gap:18px;flex-wrap:wrap}\n  /* cinematic CTAs — squared plaques with an engraved gold keyline */\n  .hero-ctas .btn-primary{display:inline-flex;align-items:center;gap:9px;border-radius:5px;\n    padding:0 32px;min-height:56px;background:var(--tangerine);color:var(--cream);\n    font-family:'Fredoka',sans-serif;font-weight:600;text-transform:uppercase;letter-spacing:.16em;font-size:.8rem;\n    box-shadow:inset 0 0 0 1.5px rgba(244,185,46,.7), 0 12px 30px rgba(255,106,43,.34);\n    transition:transform .35s var(--ease),background .35s var(--ease),box-shadow .35s var(--ease)}\n  .hero-ctas .btn-primary:hover{background:#ec5a1d;transform:translateY(-3px);\n    box-shadow:inset 0 0 0 1.5px var(--marigold), 0 16px 40px rgba(255,106,43,.48)}\n  .hero-ctas .btn-text{display:inline-flex;align-items:center;gap:11px;border-radius:5px;\n    padding:0 26px;min-height:56px;background:rgba(246,239,224,.04);color:var(--cream);\n    font-family:'Fredoka',sans-serif;font-weight:600;text-transform:uppercase;letter-spacing:.16em;font-size:.78rem;\n    box-shadow:inset 0 0 0 1px rgba(246,239,224,.42);\n    transition:transform .35s var(--ease),background .35s var(--ease),box-shadow .35s var(--ease)}\n  .hero-ctas .btn-text:hover{background:rgba(246,239,224,.1);transform:translateY(-3px);\n    box-shadow:inset 0 0 0 1px var(--marigold)}\n  .hero-ctas .btn-text .star{background:var(--marigold)}\n  .hero-proof{position:relative;z-index:3;display:flex;align-items:center;justify-content:center;flex-wrap:wrap;gap:14px 18px;\n    padding-top:22px;padding-bottom:30px;font-size:.82rem;color:var(--cream);opacity:.92;text-shadow:0 1px 12px rgba(22,24,58,.7)}\n  .hero-proof i{width:4px;height:4px;border-radius:50%;background:var(--marigold);opacity:.7}\n  .hero-proof b{font-family:'Fredoka',sans-serif;font-weight:700;color:var(--marigold);font-style:normal}\n  .hero-scroll{position:absolute;z-index:3;left:50%;bottom:22px;transform:translateX(-50%);\n    width:42px;height:42px;border-radius:50%;border:1px solid rgba(246,239,224,.35);color:var(--cream);\n    display:flex;align-items:center;justify-content:center;font-size:1.1rem;animation:bob 2.4s var(--ease) infinite}\n  .hero-scroll:hover{background:rgba(246,239,224,.12)}\n  @keyframes bob{0%,100%{transform:translate(-50%,0)}50%{transform:translate(-50%,7px)}}\n  /* staged reveal of supporting copy after the headline lands */\n  .hero-eyebrow,.hero-sub,.hero-ctas,.hero-proof{opacity:0;transform:translateY(16px);\n    transition:opacity .8s var(--ease),transform .8s var(--ease)}\n  .hero.is-in .hero-eyebrow{opacity:1;transform:none;transition-delay:.05s}\n  .hero.is-in .hero-sub{opacity:.92;transform:none;transition-delay:.5s}\n  .hero.is-in .hero-ctas{opacity:1;transform:none;transition-delay:.62s}\n  .hero.is-in .hero-proof{opacity:.88;transform:none;transition-delay:.74s}\n  /* nav overlays the hero on a transparent bar */\n  header.wrap{position:absolute;top:0;left:0;right:0;z-index:50}\n  header.wrap .brandname,header.wrap .navlinks a,header.wrap .signin,header.wrap .brandtag{text-shadow:0 1px 12px rgba(22,24,58,.65)}\n  header.wrap .brandname,header.wrap .navlinks a,header.wrap .signin{color:var(--cream)}\n  header.wrap .brandtag{color:rgba(246,239,224,.7)}\n  header.wrap .navlinks a:hover{color:var(--marigold)}\n  header.wrap .logo-dot{background:rgba(246,239,224,.14);box-shadow:inset 0 0 0 1px rgba(246,239,224,.3)}\n\n  /* CATALOG */\n  .catalog{color:var(--cream);padding:96px 0;position:relative;overflow:hidden}\n  .cat-head{display:flex;justify-content:space-between;align-items:flex-end;gap:40px;margin-bottom:34px;flex-wrap:wrap}\n  .cat-head .eyebrow{color:var(--marigold)}\n  .cat-head h2{font-family:'Fredoka',sans-serif;font-weight:700;font-size:clamp(2.2rem,4.4vw,3.6rem);line-height:.95;margin-top:10px;max-width:11ch}\n  .cat-head h2 .clip{display:inline-block;overflow:hidden;vertical-align:bottom;max-width:100%}\n  .cat-head h2 .clip i{display:inline-block;clip-path:inset(0 100% 0 0);transition:clip-path 1s var(--ease);font-style:normal;white-space:normal}\n  .is-in h2 .clip i{clip-path:inset(0 0 0 0)}\n  .cat-head h2 .tang{color:var(--tangerine);font-weight:500;font-style:italic}\n  .cat-intro{max-width:34ch;font-size:.92rem;color:rgba(246,239,224,.65);text-align:right;font-style:italic}\n  .pills{display:flex;flex-wrap:wrap;gap:12px;margin-bottom:48px}\n  .pill{background:var(--cream);color:var(--ink);font-weight:500;font-size:.85rem;padding:10px 20px;\n    border-radius:999px;transition:background .3s var(--ease),color .3s var(--ease)}\n  .pill.active{background:var(--tangerine);color:var(--cream);font-weight:600}\n  .pill:hover{background:var(--aqua);color:var(--cream)}\n  .pill-sep{width:1px;height:36px;background:rgba(246,239,224,.2);margin:0 6px;align-self:center}\n  .grid-scene{perspective:1500px}\n  .bookgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:30px;transform-style:preserve-3d}\n  .book{position:relative;transform-style:preserve-3d;will-change:transform;\n    transform:rotateX(calc(var(--my,0) * -6deg)) rotateY(calc(var(--mx,0) * 6deg)) translateZ(var(--zsep,0px));\n    transition:transform .3s var(--ease);opacity:0}\n  .book.rise{opacity:1}\n  .book .cover{position:relative;aspect-ratio:2/3;border-radius:12px;overflow:hidden;\n    box-shadow:0 14px 34px rgba(0,0,0,.34);background:var(--aqua)}\n  .book .cover img{width:100%;height:100%;object-fit:cover;display:block}\n  .book .peek{position:absolute;inset:0;display:flex;align-items:flex-end;padding:14px;\n    background:rgba(22,24,58,.7);color:var(--cream);font-style:italic;font-size:.8rem;\n    opacity:0;transition:opacity .4s var(--ease)}\n  .book:hover{transform:rotateX(calc(var(--my,0) * -6deg)) rotateY(calc(var(--mx,0) * 6deg)) translateZ(calc(var(--zsep,0px) + 50px)) scale(1.02)}\n  .book:hover .peek{opacity:1}\n  .book .meta{margin-top:14px}\n  .book .title{font-family:'Fredoka',sans-serif;font-weight:600;font-size:1.15rem;line-height:1.05}\n  .book .by{font-size:.78rem;color:rgba(246,239,224,.6);font-style:italic;margin-top:4px}\n  .book .row{margin-top:12px;display:flex;align-items:center;justify-content:space-between}\n  .tag{font-size:.7rem;padding:4px 11px;border-radius:999px;font-weight:600}\n  .price{font-family:'Fredoka',sans-serif;font-weight:700;font-size:1.1rem;color:var(--marigold)}\n  .seeall{display:flex;align-items:center;justify-content:center;text-align:center;border-radius:12px;\n    aspect-ratio:2/3;background:rgba(244,185,46,.14);border:2px dashed rgba(244,185,46,.4)}\n  .seeall .disp{font-size:1.5rem;color:var(--marigold)}\n  .cat-foot{margin-top:30px;font-style:italic;font-size:.9rem;color:rgba(246,239,224,.7);display:flex;align-items:center;gap:10px}\n\n  /* CLASSROOM sticky stack */\n  .classroom-outer{position:relative;height:400vh}\n  .panel{position:sticky;top:0;height:100vh;overflow:hidden;display:flex;align-items:center;\n    border-radius:0;transform-origin:center top;will-change:transform}\n  .panel-inner{width:100%;max-width:1240px;margin:0 auto;padding:0 48px;position:relative;z-index:3;\n    filter:blur(10px);opacity:0;transition:filter .7s var(--ease),opacity .7s var(--ease)}\n  .panel.locked .panel-inner{filter:blur(0);opacity:1}\n  .panel .bgphoto{position:absolute;inset:0}\n  .panel .bgphoto img{width:100%;height:100%;object-fit:cover;display:block}\n  .panel .bgphoto::after{content:'';position:absolute;inset:0}\n  .p1{background:var(--paper)}\n  .p2{background:var(--tangerine)} .p2 .bgphoto::after{background:rgba(255,106,43,.55)}\n  .p3{background:var(--aqua)} .p3 .bgphoto::after{background:rgba(31,182,196,.55)}\n  .p4{background:var(--night)} .p4 .bgphoto::after{background:rgba(22,24,58,.62)}\n  .p1 .eyebrow{color:var(--aqua)}\n  .p1 h2{font-family:'Fredoka',sans-serif;font-weight:700;font-size:clamp(2.4rem,5.2vw,4.2rem);line-height:.95;margin-top:10px;max-width:14ch}\n  .p1 h2 .tang{color:var(--tangerine);font-style:italic;font-weight:500}\n  .p1 .lead{margin-top:20px;max-width:46ch;font-size:1.05rem;color:rgba(26,27,51,.78)}\n  .checks{margin-top:24px;display:flex;flex-direction:column;gap:12px;max-width:42ch}\n  .checks li{list-style:none;display:flex;gap:12px;align-items:flex-start;font-size:.95rem}\n  .checks .ck{flex:0 0 auto;width:22px;height:22px;border-radius:50%;background:var(--aqua);color:var(--cream);\n    display:flex;align-items:center;justify-content:center;font-weight:700;font-size:.8rem;margin-top:2px}\n  .p1 .ctas{margin-top:32px;display:flex;gap:20px;align-items:center;flex-wrap:wrap}\n  .bignum{font-family:'Fredoka',sans-serif;font-weight:700;color:var(--cream);\n    font-size:clamp(5rem,14vw,11rem);line-height:.82}\n  .panel.dark .panel-content{color:var(--cream)}\n  .panel-content{max-width:620px}\n  .panel-content .lab{font-family:'Fredoka',sans-serif;text-transform:uppercase;letter-spacing:.2em;\n    font-weight:500;font-size:.78rem;color:var(--cream);opacity:.85}\n  .panel-content .big{font-family:'Fredoka',sans-serif;font-weight:700;font-size:clamp(2rem,4.6vw,3.6rem);\n    line-height:1.02;margin-top:14px;color:var(--cream)}\n  .panel-content .big .it{font-style:italic;font-weight:500}\n  .panel-content .sub{margin-top:16px;font-size:1.05rem;color:var(--cream);opacity:.92;max-width:40ch}\n  .p4 .ctas{margin-top:32px;display:flex;gap:20px;align-items:center;flex-wrap:wrap}\n  .quoteline{font-family:'Fredoka',sans-serif;font-weight:500;font-style:italic;\n    font-size:clamp(1.6rem,3.6vw,2.8rem);line-height:1.12;color:var(--cream);max-width:18ch}\n  .quoteline .who{display:block;font-style:normal;font-weight:600;font-size:1rem;margin-top:18px;opacity:.9;font-family:'Quicksand',sans-serif}\n\n  /* EVENTS timeline */\n  .events{padding:96px 0;position:relative}\n  .ev-head{display:flex;justify-content:space-between;align-items:flex-end;gap:40px;margin-bottom:60px;flex-wrap:wrap}\n  .ev-head .eyebrow{color:var(--tangerine)}\n  .ev-head h2{font-family:'Fredoka',sans-serif;font-weight:700;font-size:clamp(2.4rem,5vw,4rem);\n    line-height:.95;margin-top:10px;transform:translateY(34px) skewY(5deg);opacity:0;\n    transition:transform 1s var(--ease),opacity 1s var(--ease)}\n  .ev-head.is-in h2{transform:translateY(0) skewY(0);opacity:1}\n  .ev-head h2 .aqua{color:var(--aqua);font-style:italic;font-weight:500}\n  .ev-intro{max-width:30ch;font-size:.92rem;color:rgba(26,27,51,.6);font-style:italic;text-align:right}\n  .thread{position:relative;padding-left:84px}\n  .spine{position:absolute;left:30px;top:6px;bottom:6px;width:4px;border-radius:4px;\n    background:repeating-linear-gradient(180deg,var(--aqua) 0 10px,transparent 10px 18px);\n    transform:scaleY(0);transform-origin:top center;will-change:transform}\n  .ev{position:relative;margin-bottom:34px;opacity:0;transform:translateY(28px);\n    transition:opacity .8s var(--ease),transform .8s var(--ease)}\n  .ev.rise{opacity:1;transform:translateY(0)}\n  .ev .marker{position:absolute;left:-66px;top:18px;width:30px;height:30px}\n  .ev .card2{background:#fff;border-radius:18px;padding:26px 30px;display:grid;\n    grid-template-columns:auto 1fr auto;gap:26px;align-items:center;\n    box-shadow:0 10px 30px rgba(22,24,58,.1)}\n  .ev .date .mo{font-family:'Fredoka',sans-serif;text-transform:uppercase;letter-spacing:.16em;\n    font-weight:500;font-size:.8rem;color:var(--tangerine)}\n  .ev .date .dy{font-family:'Fredoka',sans-serif;font-weight:700;font-size:3.2rem;line-height:.85}\n  .ev .date .tm{font-size:.78rem;font-style:italic;color:rgba(26,27,51,.65);margin-top:4px}\n  .ev .body .venue{font-size:.84rem;font-style:italic;color:rgba(26,27,51,.7)}\n  .ev .body .ti{font-family:'Fredoka',sans-serif;font-weight:600;font-size:1.35rem;line-height:1.12;margin-top:4px}\n  .ev .body .det{font-size:.84rem;font-style:italic;color:rgba(26,27,51,.7);margin-top:8px}\n  .ev .who2{display:flex;align-items:center;gap:14px;text-align:right;will-change:transform}\n  .ev .who2 .nm{font-weight:600;font-size:.9rem}\n  .ev .who2 .rl{font-size:.8rem;font-style:italic;color:rgba(26,27,51,.7)}\n  .portrait{width:56px;height:56px;border-radius:50%;overflow:hidden;flex:0 0 auto;background:var(--marigold)}\n  .portrait img{width:100%;height:100%;object-fit:cover;display:block}\n  .pstack{display:flex}\n  .pstack .portrait{margin-left:-16px;border:3px solid var(--paper)}\n  .pstack .portrait:first-child{margin-left:0}\n  .ev-foot{text-align:center;margin-top:30px}\n  .ev-foot a{color:var(--tangerine);font-weight:600;border-bottom:2px solid var(--tangerine);padding-bottom:2px}\n\n  /* FOOTER */\n  footer{color:var(--cream);position:relative;overflow:hidden;padding:84px 0 40px}\n  .fshape{position:absolute;will-change:transform;pointer-events:none}\n  .fs1{top:40px;left:60px;width:60px;height:60px;background:var(--marigold);opacity:.22;\n    clip-path:polygon(50% 0%,61% 35%,98% 35%,68% 57%,79% 91%,50% 70%,21% 91%,32% 57%,2% 35%,39% 35%)}\n  .fs2{top:120px;right:120px;width:90px;height:90px;border-radius:50%;background:var(--tangerine);opacity:.14}\n  .fs3{bottom:140px;left:34%;width:44px;height:44px;background:var(--aqua);opacity:.24;\n    clip-path:polygon(50% 0%,60% 40%,100% 50%,60% 60%,50% 100%,40% 60%,0% 50%,40% 40%)}\n  .news{display:grid;grid-template-columns:1.1fr 1fr;gap:48px;align-items:start;position:relative;z-index:3}\n  .news .eyebrow{color:var(--marigold)}\n  .news h3{font-family:'Fredoka',sans-serif;font-weight:700;font-size:clamp(2rem,4.4vw,3.2rem);\n    line-height:.98;margin-top:10px}\n  .news h3 .tang{color:var(--tangerine);font-style:italic;font-weight:500}\n  .news p{margin-top:18px;max-width:42ch;font-style:italic;font-size:.92rem;opacity:.72}\n  .subrow{margin-top:14px;display:flex;gap:12px;align-items:center;max-width:480px}\n  .subrow input{flex:1;background:transparent;border:none;border-bottom:2px solid rgba(246,239,224,.3);\n    color:var(--cream);font-family:'Fredoka',sans-serif;font-size:1.15rem;padding:10px 4px}\n  .subrow input::placeholder{color:rgba(246,239,224,.4)}\n  .subrow input:focus{border-bottom-color:var(--marigold);outline:none}\n  .join{margin-top:18px;display:flex;align-items:baseline;gap:16px}\n  .join .n{font-family:'Fredoka',sans-serif;font-weight:700;font-size:clamp(2.6rem,7vw,4.6rem);\n    color:var(--marigold);line-height:.8}\n  .join .t{font-style:italic;font-size:.9rem;opacity:.78;max-width:18ch}\n  .fdiv{height:2px;background:rgba(246,239,224,.18);margin:54px 0;position:relative;z-index:3}\n  .cols{display:grid;grid-template-columns:1.6fr 1fr 1fr 1fr 1fr;gap:28px;position:relative;z-index:3}\n  .cols .brandrow{margin-bottom:14px}\n  .cols .brandname{color:var(--cream)}\n  .cols .blurb{font-size:.78rem;font-style:italic;opacity:.6;max-width:30ch;line-height:1.6}\n  .cols h4{font-family:'Fredoka',sans-serif;text-transform:uppercase;letter-spacing:.18em;\n    font-weight:500;font-size:.7rem;color:var(--marigold);margin-bottom:14px}\n  .cols ul{list-style:none}\n  .cols li{margin-bottom:8px;opacity:.82;font-size:.9rem}\n  .cols li a:hover{color:var(--marigold)}\n  .social{display:flex;gap:14px}\n  .social a{width:34px;height:34px;border-radius:50%;background:rgba(246,239,224,.12);\n    display:flex;align-items:center;justify-content:center;transition:background .3s var(--ease)}\n  .social a:hover{background:var(--marigold)}\n  .social svg{width:18px;height:18px;fill:var(--cream)}\n  .finefoot{margin-top:48px;padding-top:24px;border-top:1px solid rgba(246,239,224,.15);\n    display:flex;justify-content:space-between;align-items:center;gap:20px;flex-wrap:wrap;\n    font-size:.82rem;font-style:italic;opacity:.7;position:relative;z-index:3}\n  .finefoot .legal{display:flex;gap:22px}\n\n  .reveal{opacity:0;transform:translateY(26px);transition:opacity .9s var(--ease),transform .9s var(--ease)}\n  .reveal.rise{opacity:1;transform:translateY(0)}\n\n  /* magical section headings — Cinzel Decorative across the page */\n  .cat-head h2,.p1 h2,.ev-head h2,.news h3,.panel-content .big{\n    font-family:'Cinzel Decorative','Cinzel',serif;font-weight:700;line-height:1.16;letter-spacing:.012em}\n  /* Cinzel Decorative has no italic — keep accent words upright (colour carries the emphasis) */\n  .p1 h2 .tang,.ev-head h2 .aqua,.news h3 .tang,.panel-content .big .it{font-style:normal}\n\n  /* RESPONSIVE */\n  @media(max-width:980px){\n    .news{grid-template-columns:1fr;gap:32px}\n    .cols{grid-template-columns:1fr 1fr 1fr}\n    .bookgrid{grid-template-columns:repeat(2,1fr)}\n    .brandtag{display:none}\n    .hero-h1{font-size:clamp(2.6rem,9vw,4rem)}\n    .hero-orbit{width:140vw}\n  }\n  @media(max-width:768px){\n    .navlinks,.signin{display:none}\n    .wrap{padding:0 20px}\n    .cat-intro,.ev-intro{text-align:left}\n    .cat-head,.ev-head{flex-direction:column;align-items:flex-start}\n    /* sticky stack -> normal stacked full-height sections */\n    .classroom-outer{height:auto}\n    .panel{position:relative;height:auto;min-height:88vh;padding:60px 0}\n    .panel-inner{filter:none;opacity:1}\n    .panel-content,.p1 h2{max-width:100%}\n    .ev .card2{grid-template-columns:1fr;gap:14px}\n    .ev .who2{justify-content:flex-start;text-align:left}\n    .thread{padding-left:54px}\n    .spine{left:18px}\n    .ev .marker{left:-50px}\n    .panel-inner{padding:0 20px}\n    