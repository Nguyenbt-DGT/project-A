ets-dev.b-cdn.net/generated_assets/8_landing_page_for_a_gouache_illustrated_childrens_astronomy_book_imprint/assets/hero.png\" data-kid=\"27\">\n    <source src=\"https://kombai-assets-dev.b-cdn.net/generated_assets/8_landing_page_for_a_gouache_illustrated_childrens_astronomy_book_imprint/assets/hero.mp4\" type=\"video/mp4\" data-kid=\"28\">\n  </video>\n  <div class=\"hero-scrim\" aria-hidden=\"true\" data-kid=\"29\"></div>\n\n  <div class=\"hero-inner wrap\" data-kid=\"30\">\n    <div class=\"eyebrow hero-eyebrow\" data-kid=\"31\">Featured Volume · No. 24</div>\n    <h1 class=\"hero-h1 disp\" id=\"heroH1\" aria-label=\"A field guide to starlight.\" data-kid=\"32\">\n      <span class=\"ln\" data-kid=\"33\"><span data-kid=\"34\">A field guide</span></span>\n      <span class=\"ln\" data-kid=\"35\"><span data-kid=\"36\">to <span class=\"tang\" data-kid=\"37\">starlight.</span></span></span>\n    </h1>\n    <p class=\"hero-sub\" data-kid=\"38\">Watercolor picture books that carry young readers from the bedroom window to the edge of the observable universe.</p>\n    <div class=\"hero-ctas\" data-kid=\"39\">\n      <button class=\"btn-primary\" data-kid=\"40\">Explore the Universe&nbsp;→</button>\n      <button class=\"btn-text\" data-kid=\"41\"><span class=\"star\" data-kid=\"42\"></span> Watch the trailer</button>\n    </div>\n  </div>\n\n  <div class=\"hero-proof wrap\" data-kid=\"43\">\n    <span data-kid=\"44\">★ <b data-kid=\"45\">4.9</b> · 2,400 reviews</span><i data-kid=\"46\"></i>\n    <span data-kid=\"47\"><b data-kid=\"48\">Caldecott</b> Honor 2024</span><i data-kid=\"49\"></i>\n    <span data-kid=\"50\"><b data-kid=\"51\">142</b> titles · 18 languages</span><i data-kid=\"52\"></i>\n    <span data-kid=\"53\"><b data-kid=\"54\">3.2M</b> young stargazers</span>\n  </div>\n\n  <a class=\"hero-scroll\" href=\"#catalog\" aria-label=\"Scroll to the catalog\" data-kid=\"55\">↓</a>\n</section>\n\n\n<section class=\"catalog night-tex\" id=\"catalog\" data-kid=\"56\">\n  <div class=\"wrap\" data-kid=\"57\">\n    <div class=\"cat-head\" id=\"catHead\" data-kid=\"58\">\n      <div data-kid=\"59\">\n        <div class=\"eyebrow\" data-kid=\"60\">The Catalog</div>\n        <h2 data-kid=\"61\"><span style=\"display:block\" data-kid=\"62\">Discover</span><span class=\"clip\" data-kid=\"63\"><i class=\"tang\" data-kid=\"64\">new worlds.</i></span></h2>\n      </div>\n      <p class=\"cat-intro\" data-kid=\"65\">Filter by age, topic, or constellation. Wander through the full library — 142 painted volumes and counting.</p>\n    </div>\n\n    <div class=\"pills\" data-kid=\"66\">\n      <button class=\"pill active\" data-kid=\"67\">All books</button>\n      <button class=\"pill\" data-kid=\"68\">Ages 3–5</button>\n      <button class=\"pill\" data-kid=\"69\">Ages 6–8</button>\n      <button class=\"pill\" data-kid=\"70\">Ages 9–12</button>\n      <span class=\"pill-sep\" data-kid=\"71\"></span>\n      <button class=\"pill\" data-kid=\"72\">Constellations</button>\n      <button class=\"pill\" data-kid=\"73\">Space Exploration</button>\n      <button class=\"pill\" data-kid=\"74\">Planets &amp; Moons</button>\n      <button class=\"pill\" data-kid=\"75\">Mythology</button>\n    </div>\n\n    <div class=\"grid-scene\" data-kid=\"76\">\n      <div class=\"bookgrid\" id=\"bookgrid\" data-kid=\"77\">\n        <article class=\"book\" data-kid=\"78\">\n          <div class=\"cover\" style=\"background:var(--aqua)\" data-kid=\"79\">\n            <img src=\"https://kombai-assets-dev.b-cdn.net/generated_assets/8_landing_page_for_a_gouache_illustrated_childrens_astronomy_book_imprint/assets/books/drawing-night-sky.png\" alt=\"Drawing the Night Sky cover\" loading=\"lazy\" onerror=\"this.style.display='none'\" data-kid=\"80\">\n            <div class=\"peek\" data-kid=\"81\">page 14 · \"the milky way\"</div>\n          </div>\n          <div class=\"meta\" data-kid=\"82\">\n            <div class=\"title\" data-kid=\"83\">Drawing the Night Sky</div>\n            <div class=\"by\" data-kid=\"84\">by Halima Okafor · ages 6–8 · 48 pp.</div>\n            <div class=\"row\" data-kid=\"85\"><span class=\"tag\" style=\"background:rgba(31,182,196,.22);color:var(--aqua)\" data-kid=\"86\">Constellations</span><span class=\"price\" data-kid=\"87\">$18</span></div>\n          </div>\n        </article>\n\n        <article class=\"book\" data-kid=\"88\">\n          <div class=\"cover\" style=\"background:var(--tangerine)\" data-kid=\"89\">\n            <img src=\"https://kombai-assets-dev.b-cdn.net/generated_assets/8_landing_page_for_a_gouache_illustrated_childrens_astronomy_book_imprint/assets/books/if-i-lived-on-mars.png\" alt=\"If I Lived on Mars cover\" loading=\"lazy\" onerror=\"this.style.display='none'\" data-kid=\"90\">\n            <div class=\"peek\" data-kid=\"91\">page 22 · \"the dunes of mars\"</div>\n          </div>\n          <div class=\"meta\" data-kid=\"92\">\n            <div class=\"title\" data-kid=\"93\">If I Lived on Mars</div>\n            <div class=\"by\" data-kid=\"94\">by Theo Lindqvist · ages 4–7 · 36 pp.</div>\n            <div class=\"row\" data-kid=\"95\"><span class=\"tag\" style=\"background:rgba(255,106,43,.22);color:var(--tangerine)\" data-kid=\"96\">Planets</span><span class=\"price\" data-kid=\"97\">$16</span></div>\n          </div>\n        </article>\n\n        <article class=\"book\" data-kid=\"98\">\n          <div class=\"cover\" style=\"background:var(--marigold)\" data-kid=\"99\">\n            <img src=\"https://kombai-assets-dev.b-cdn.net/generated_assets/8_landing_page_for_a_gouache_illustrated_childrens_astronomy_book_imprint/assets/books/nine-bright-neighbours.png\" alt=\"Nine Bright Neighbours cover\" loading=\"lazy\" onerror=\"this.style.display='none'\" data-kid=\"100\">\n            <div class=\"peek\" data-kid=\"101\">page 8 · \"the solar family\"</div>\n          </div>\n          <div class=\"meta\" data-kid=\"102\">\n            <div class=\"title\" data-kid=\"103\">Nine Bright Neighbours</div>\n            <div class=\"by\" data-kid=\"104\">by Priya Raghavan · ages 5–8 · 52 pp.</div>\n            <div class=\"row\" data-kid=\"105\"><span class=\"tag\" style=\"background:rgba(244,185,46,.22);color:var(--marigold)\" data-kid=\"106\">Planets</span><span class=\"price\" data-kid=\"107\">$18</span></div>\n          </div>\n        </article>\n\n        <article class=\"book\" data-kid=\"108\">\n          <div class=\"cover\" style=\"background:var(--aqua)\" data-kid=\"109\">\n            <img src=\"https://kombai-assets-dev.b-cdn.net/generated_assets/8_landing_page_for_a_gouache_illustrated_childrens_astronomy_book_imprint/assets/books/moonbook.png\" alt=\"Moonbook cover\" loading=\"lazy\" onerror=\"this.style.display='none'\" data-kid=\"110\">\n            <div class=\"peek\" data-kid=\"111\">page 31 · \"the dark side\"</div>\n          </div>\n          <div class=\"meta\" data-kid=\"112\">\n            <div class=\"title\" data-kid=\"113\">Moonbook</div>\n            <div class=\"by\" data-kid=\"114\">by Wren Hollister · ages 3–5 · 24 pp.</div>\n            <div class=\"row\" data-kid=\"115\"><span class=\"tag\" style=\"background:rgba(31,182,196,.22);color:var(--aqua)\" data-kid=\"116\">Our Moon</span><span class=\"price\" data-kid=\"117\">$14</span></div>\n          </div>\n        </article>\n\n        <article class=\"book\" data-kid=\"118\">\n          <div class=\"cover\" style=\"background:var(--tangerine)\" data-kid=\"119\">\n            <img src=\"https://kombai-assets-dev.b-cdn.net/generated_assets/8_landing_page_for_a_gouache_illustrated_childrens_astronomy_book_imprint/assets/books/the-long-voyage.png\" alt=\"The Long Voyage cover\" loading=\"lazy\" onerror=\"this.style.display='none'\" data-kid=\"120\">\n            <div class=\"peek\" data-kid=\"121\">page 5 · \"first stars\"</div>\n          </div>\n          <div class=\"meta\" data-kid=\"122\">\n            <div class=\"title\" data-kid=\"123\">The Long Voyage</div>\n            <div class=\"by\" data-kid=\"124\">by Sam Beauregard · ages 9–12 · 96 pp.</div>\n            <div class=\"row\" data-kid=\"125\"><span class=\"tag\" style=\"background:rgba(255,106,43,.22);color:var(--tangerine)\" data-kid=\"126\">Exploration</span><span class=\"price\" data-kid=\"127\">$22</span></div>\n          </div>\n        </article>\n\n        <article class=\"book\" data-kid=\"128\">\n          <a class=\"seeall\" href=\"#catalog\" data-kid=\"129\">\n            <div class=\"disp\" data-kid=\"130\">See all 142<br data-kid=\"131\"><span style=\"font-style:italic\" data-kid=\"132\">titles&nbsp;→</span></div>\n          </a>\n        </article>\n      </div>\n    </div>\n    <div class=\"cat-foot\" data-kid=\"133\"><span class=\"star\" data-kid=\"134\"></span> tilt your cursor across the shelf — hover any cover to peek inside</div>\n  </div>\n</section>\n\n\n<section id=\"classroom\" data-kid=\"135\">\n<div class=\"classroom-outer\" id=\"classroomOuter\" data-kid=\"136\">\n\n  <div class=\"panel p1\" data-panel=\"0\" data-kid=\"137\">\n    <div class=\"panel-inner\" data-kid=\"138\">\n      <div class=\"eyebrow\" data-kid=\"139\">For Schools &amp; Libraries</div>\n      <h2 data-kid=\"140\">Bring the <span class=\"tang\" data-kid=\"141\">cosmos</span> to the classroom.</h2>\n      <p class=\"lead\" data-kid=\"142\">Curated bundles of our painted volumes, paired with teacher guides, classroom posters, and a year of monthly star-maps. Built with educators across 1,200 schools.</p>\n      <ul class=\"checks\" data-kid=\"143\">\n        <li data-kid=\"144\"><span class=\"ck\" data-kid=\"145\">✓</span><span data-kid=\"146\">Aligned to Common Core &amp; NGSS K–5 science standards</span></li>\n        <li data-kid=\"147\"><span class=\"ck\" data-kid=\"148\">✓</span><span data-kid=\"149\">Includes 30-book bundle, 12 lesson plans, wall-sized orrery print</span></li>\n        <li data-kid=\"150\"><span class=\"ck\" data-kid=\"151\">✓</span><span data-kid=\"152\">Title I schools receive 35% off &amp; free shipping</span></li>\n      </ul>\n      <div class=\"ctas\" data-kid=\"153\">\n        <button class=\"btn-primary\" data-kid=\"154\">Request a Classroom Quote</button>\n        <button class=\"btn-text\" style=\"color:var(--ink)\" data-kid=\"155\"><span class=\"star\" data-kid=\"156\"></span> Download sample lesson (PDF)</button>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"panel p2 dark\" data-panel=\"1\" data-kid=\"157\">\n    <div class=\"bgphoto\" data-kid=\"158\"><img src=\"https://kombai-assets-dev.b-cdn.net/generated_assets/8_landing_page_for_a_gouache_illustrated_childrens_astronomy_book_imprint/assets/classroom/panel-classroom.png\" alt=\"Children reading painted astronomy books in a classroom\" loading=\"lazy\" onerror=\"this.style.display='none'\" data-kid=\"159\"></div>\n    <div class=\"panel-inner\" data-kid=\"160\">\n      <div class=\"panel-content\" data-kid=\"161\">\n        <div class=\"bignum\" data-kid=\"162\">30</div>\n        <div class=\"lab\" data-kid=\"163\">books per bundle, spanning ages 4 to 12</div>\n        <div class=\"big\" data-kid=\"164\">Teacher Guides <span class=\"it\" data-kid=\"165\">included</span></div>\n        <div class=\"sub\" data-kid=\"166\">12 lessons + printables packed beside every wall-sized orrery print.</div>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"panel p3 dark\" data-panel=\"2\" data-kid=\"167\">\n    <div class=\"bgphoto\" data-kid=\"168\"><img src=\"https://kombai-assets-dev.b-cdn.net/generated_assets/8_landing_page_for_a_gouache_illustrated_childrens_astronomy_book_imprint/assets/classroom/panel-bundle.png\" alt=\"A bundle of painted picture books with an orrery print\" loading=\"lazy\" onerror=\"this.style.display='none'\" data-kid=\"169\"></div>\n    <div class=\"panel-inner\" data-kid=\"170\">\n      <div class=\"panel-content\" data-kid=\"171\">\n        <div class=\"bignum\" data-kid=\"172\">1,247</div>\n        <div class=\"lab\" data-kid=\"173\">schools currently using Little Orrery sets</div>\n        <div class=\"quoteline\" data-kid=\"174\">\"The kids ask to read these every single afternoon.\"\n          <span class=\"who\" data-kid=\"175\">Maple Grove Elementary, Vermont</span>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"panel p4 dark\" data-panel=\"3\" data-kid=\"176\">\n    <div class=\"bgphoto\" data-kid=\"177\"><img src=\"https://kombai-assets-dev.b-cdn.net/generated_assets/8_landing_page_for_a_gouache_illustrated_childrens_astronomy_book_imprint/assets/classroom/panel-ship.png\" alt=\"A wrapped parcel of books ready to ship\" loading=\"lazy\" onerror=\"this.style.display='none'\" data-kid=\"178\"></div>\n    <div class=\"panel-inner\" data-kid=\"179\">\n      <div class=\"panel-content\" data-kid=\"180\">\n        <div class=\"big\" data-kid=\"181\">Ships within <span class=\"it\" data-kid=\"182\">5 days</span></div>\n        <div class=\"sub\" data-kid=\"183\">Free over $250 — to every school and library in the country.</div>\n        <div class=\"ctas\" data-kid=\"184\">\n          <button class=\"btn-primary\" data-kid=\"185\">Request a Classroom Quote</button>\n          <button class=\"btn-text\" data-kid=\"186\"><span class=\"star\" data-kid=\"187\"></span> Download sample lesson (PDF)</button>\n        </div>\n      </div>\n    </div>\n  </div>\n\n</div>\n</section>\n\n\n<section class=\"events wrap\" id=\"events\" data-kid=\"188\">\n  <div class=\"ev-head\" id=\"evHead\" data-kid=\"189\">\n    <div data-kid=\"190\">\n      <div class=\"eyebrow\" data-kid=\"191\">Visiting Authors · Autumn 2025</div>\n      <h2 data-kid=\"192\">Readings &amp; <span class=\"aqua\" data-kid=\"193\">stargazings.</span></h2>\n    </div>\n    <p class=\"ev-intro\" data-kid=\"194\">Free, family-friendly evenings at bookshops, planetariums, and libraries across the country. Bring a blanket — most readings end outside, under the stars.</p>\n  </div>\n\n  <div class=\"thread\" id=\"thread\" data-kid=\"195\">\n    <div class=\"spine\" id=\"spine\" data-kid=\"196\"></div>\n\n    <div class=\"ev\" id=\"authors\" data-kid=\"197\">\n      <div class=\"marker\" data-kid=\"198\"><span class=\"star\" style=\"width:30px;height:30px\" data-kid=\"199\"></span></div>\n      <div class=\"card2\" data-kid=\"200\">\n        <div class=\"date\" data-kid=\"201\"><div class=\"mo\" data-kid=\"202\">Oct</div><div class=\"dy disp\" style=\"color:var(--tangerine)\" data-kid=\"203\">14</div><div class=\"tm\" data-kid=\"204\">Tuesday, 6:30pm</div></div>\n        <div class=\"body\" data-kid=\"205\">\n          <div class=\"venue\" data-kid=\"206\">Brookline Booksmith · Boston, MA</div>\n          <div class=\"ti\" data-kid=\"207\">\"Drawing the Night Sky\" — a reading &amp; constellation workshop</div>\n          <div class=\"det\" data-kid=\"208\">with Halima Okafor · ages 6+ welcome · free, RSVP required</div>\n        </div>\n        <div class=\"who2\" data-kid=\"209\">\n          <div data-kid=\"210\"><div class=\"nm\" data-kid=\"211\">Halima Okafor</div><div class=\"rl\" data-kid=\"212\">author &amp; illustrator</div></div>\n          <div class=\"portrait\" data-kid=\"213\"><img src=\"https://kombai-assets-dev.b-cdn.net/generated_assets/8_landing_page_for_a_gouache_illustrated_childrens_astronomy_book_imprint/assets/authors/halima.png\" alt=\"Portrait of Halima Okafor\" loading=\"lazy\" onerror=\"this.style.display='none'\" data-kid=\"214\"></div>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"ev\" data-kid=\"215\">\n      <div class=\"marker\" data-kid=\"216\"><span class=\"star\" style=\"width:30px;height:30px;background:var(--aqua)\" data-kid=\"217\"></span></div>\n      <div class=\"card2\" data-kid=\"218\">\n        <div class=\"date\" data-kid=\"219\"><div class=\"mo\" data-kid=\"220\">Oct</div><div class=\"dy disp\" style=\"color:var(--aqua)\" data-kid=\"221\">22</div><div class=\"tm\" data-kid=\"222\">Wednesday, 7:00pm</div></div>\n        <div class=\"body\" data-kid=\"223\">\n          <div class=\"venue\" data-kid=\"224\">Adler Planetarium · Chicago, IL</div>\n          <div class=\"ti\" data-kid=\"225\">A dome-reading of \"If I Lived on Mars,\" under the stars</div>\n          <div class=\"det\" data-kid=\"226\">with Theo Lindqvist · ages 4–9 · $8 family ticket</div>\n        </div>\n        <div class=\"who2\" data-kid=\"227\">\n          <div data-kid=\"228\"><div class=\"nm\" data-kid=\"229\">Theo Lindqvist</div><div class=\"rl\" data-kid=\"230\">author</div></div>\n          <div class=\"portrait\" data-kid=\"231\"><img src=\"https://kombai-assets-dev.b-cdn.net/generated_assets/8_landing_page_for_a_gouache_illustrated_childrens_astronomy_book_imprint/assets/authors/theo.png\" alt=\"Portrait of Theo Lindqvist\" loading=\"lazy\" onerror=\"this.style.display='none'\" data-kid=\"232\"></div>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"ev\" data-kid=\"233\">\n      <div class=\"marker\" data-kid=\"234\"><span class=\"star\" style=\"width:30px;height:30px;background:var(--tangerine)\" data-kid=\"235\"></span></div>\n      <div class=\"card2\" data-kid=\"236\">\n        <div class=\"date\" data-kid=\"237\"><div class=\"mo\" data-kid=\"238\">Nov</div><div class=\"dy disp\" style=\"color:var(--tangerine)\" data-kid=\"239\">05</div><div class=\"tm\" data-kid=\"240\">Saturday, 11:00am</div></div>\n        <div class=\"body\" data-kid=\"241\">\n          <div class=\"venue\" data-kid=\"242\">Powell's City of Books · Portland, OR</div>\n          <div class=\"ti\" data-kid=\"243\">Launch of \"The Pocket Almanac of Meteor Showers\"</div>\n          <div class=\"det\" data-kid=\"244\">with Elena Marín &amp; Wren Hollister · all ages · free</div>\n        </div>\n        <div class=\"who2\" data-kid=\"245\">\n          <div class=\"pstack\" data-kid=\"246\">\n            <div class=\"portrait\" data-kid=\"247\"><img src=\"https://kombai-assets-dev.b-cdn.net/generated_assets/8_landing_page_for_a_gouache_illustrated_childrens_astronomy_book_imprint/assets/authors/elena.png\" alt=\"Portrait of Elena Marín\" loading=\"lazy\" onerror=\"this.style.display='none'\" data-kid=\"248\"></div>\n            <div class=\"portrait\" data-kid=\"249\"><img src=\"https://kombai-assets-dev.b-cdn.net/generated_assets/8_landing_page_for_a_gouache_illustrated_childrens_astronomy_book_imprint/assets/authors/wren.png\" alt=\"Portrait of Wren Hollister\" loading=\"lazy\" onerror=\"this.style.display='none'\" data-kid=\"250\"></div>\n          </div>\n          <div data-kid=\"251\"><div class=\"nm\" data-kid=\"252\">Marín &amp; Hollister</div><div class=\"rl\" data-kid=\"253\">duo reading</div></div>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"ev\" data-kid=\"254\">\n      <div class=\"marker\" data-kid=\"255\"><span class=\"star\" style=\"width:30px;height:30px;background:var(--marigold)\" data-kid=\"256\"></span></div>\n      <div class=\"card2\" data-kid=\"257\">\n        <div class=\"date\" data-kid=\"258\"><div class=\"mo\" data-kid=\"259\">Nov</div><div class=\"dy disp\" style=\"color:var(--aqua)\" data-kid=\"260\">19</div><div class=\"tm\" data-kid=\"261\">Saturday, 4:30pm</div></div>\n        <div class=\"body\" data-kid=\"262\">\n          <div class=\"venue\" data-kid=\"263\">Brooklyn Public Library · Brooklyn, NY</div>\n          <div class=\"ti\" data-kid=\"264\">\"Nine Bright Neighbours\" sing-along &amp; watercolor demo</div>\n          <div class=\"det\" data-kid=\"265\">with Priya Raghavan · ages 3–7 · free, drop-in</div>\n        </div>\n        <div class=\"who2\" data-kid=\"266\">\n          <div data-kid=\"267\"><div class=\"nm\" data-kid=\"268\">Priya Raghavan</div><div class=\"rl\" data-kid=\"269\">illustrator</div></div>\n          <div class=\"portrait\" data-kid=\"270\"><img src=\"https://kombai-assets-dev.b-cdn.net/generated_assets/8_landing_page_for_a_gouache_illustrated_childrens_astronomy_book_imprint/assets/authors/priya.png\" alt=\"Portrait of Priya Raghavan\" loading=\"lazy\" onerror=\"this.style.display='none'\" data-kid=\"271\"></div>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"ev-foot\" data-kid=\"272\"><a href=\"#events\" data-kid=\"273\">See the full tour calendar (24 dates)</a></div>\n  </div>\n</section>\n\n\n<footer class=\"night-tex\" id=\"journal\" data-kid=\"274\">\n  <span class=\"fshape fs1\" data-depth=\"-30\" data-kid=\"275\"></span>\n  <span class=\"fshape fs2\" data-depth=\"-60\" data-kid=\"276\"></span>\n  <span class=\"fshape fs3\" data-depth=\"-45\" data-kid=\"277\"></span>\n  <div class=\"wrap\" data-kid=\"278\">\n    <div class=\"news reveal\" id=\"newsBlock\" data-kid=\"279\">\n      <div data-kid=\"280\">\n        <div class=\"eyebrow\" data-kid=\"281\">The Stargazer Newsletter</div>\n        <h3 data-kid=\"282\">Once a month, a <span class=\"tang\" data-kid=\"283\">small parcel of sky</span> in your inbox.</h3>\n        <p data-kid=\"284\">Activity printables, behind-the-easel sketches from our illustrators, new releases, and the next meteor shower's exact peak time. No spam — we promise on Polaris.</p>\n      </div>\n      <div data-kid=\"285\">\n        <form class=\"subrow\" onsubmit=\"return false\" data-kid=\"286\">\n          <input type=\"email\" placeholder=\"you@stargazer.com\" aria-label=\"Your email address\" data-kid=\"287\">\n          <button class=\"btn-primary\" type=\"submit\" data-kid=\"288\">Subscribe ✦</button>\n        </form>\n        <div class=\"join\" data-kid=\"289\">\n          <span class=\"n disp\" id=\"joinNum\" data-target=\"84000\" data-kid=\"290\">0</span>\n          <span class=\"t\" data-kid=\"291\">parents, teachers, and small astronomers have joined.</span>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"fdiv\" data-kid=\"292\"></div>\n\n    <div class=\"cols reveal\" id=\"footCols\" data-kid=\"293\">\n      <div data-kid=\"294\">\n        <div class=\"brandrow\" data-kid=\"295\">\n          <span class=\"logo-dot\" data-kid=\"296\"><i class=\"d1\" data-kid=\"297\"></i><i class=\"d2\" data-kid=\"298\"></i><i class=\"d3\" data-kid=\"299\"></i></span>\n          <span class=\"brandname disp\" data-kid=\"300\">Little Orrery</span>\n        </div>\n        <p class=\"blurb\" data-kid=\"301\">An independent children's astronomy book publisher, painting the cosmos one page at a time since 2014. Based in Asheville, NC.</p>\n      </div>\n      <div data-kid=\"302\"><h4 data-kid=\"303\">Shop</h4><ul data-kid=\"304\"><li data-kid=\"305\"><a href=\"#catalog\" data-kid=\"306\">Picture books</a></li><li data-kid=\"307\"><a href=\"#catalog\" data-kid=\"308\">Activity kits</a></li><li data-kid=\"309\"><a href=\"#catalog\" data-kid=\"310\">Prints &amp; posters</a></li><li data-kid=\"311\"><a href=\"#catalog\" data-kid=\"312\">Gift cards</a></li></ul></div>\n      <div data-kid=\"313\"><h4 data-kid=\"314\">For</h4><ul data-kid=\"315\"><li data-kid=\"316\"><a href=\"#classroom\" data-kid=\"317\">Schools</a></li><li data-kid=\"318\"><a href=\"#classroom\" data-kid=\"319\">Libraries</a></li><li data-kid=\"320\"><a href=\"#classroom\" data-kid=\"321\">Booksellers</a></li><li data-kid=\"322\"><a href=\"#authors\" data-kid=\"323\">Authors</a></li></ul></div>\n      <div data-kid=\"324\"><h4 data-kid=\"325\">House</h4><ul data-kid=\"326\"><li data-kid=\"327\"><a href=\"#journal\" data-kid=\"328\">Our story</a></li><li data-kid=\"329\"><a href=\"#authors\" data-kid=\"330\">Illustrators</a></li><li data-kid=\"331\"><a href=\"#journal\" data-kid=\"332\">Press</a></li><li data-kid=\"333\"><a href=\"#journal\" data-kid=\"334\">Contact</a></li></ul></div>\n      <div data-kid=\"335\"><h4 data-kid=\"336\">Follow</h4>\n        <div class=\"social\" data-kid=\"337\">\n          <a href=\"#\" aria-label=\"Instagram\" data-kid=\"338\"><svg viewBox=\"0 0 24 24\" data-kid=\"339\"><path d=\"M12 2.2c3.2 0 3.6 0 4.9.07 1.17.05 1.95.24 2.4.4.6.24 1.04.52 1.5.98.46.46.74.9.98 1.5