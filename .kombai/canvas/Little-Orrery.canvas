.28-6.02 6.58-6.02 3.46 0 6.14 2.46 6.14 5.76 0 3.43-2.16 6.2-5.17 6.2-1 0-1.96-.52-2.28-1.14l-.62 2.36c-.22.86-.82 1.94-1.23 2.6A10 10 0 1 0 12 2z\" data-kid=\"346\"></path></svg></a>\n          <a href=\"#\" aria-label=\"RSS\" data-kid=\"347\"><svg viewBox=\"0 0 24 24\" data-kid=\"348\"><path d=\"M4 11a9 9 0 0 1 9 9h2.5A11.5 11.5 0 0 0 4 8.5V11zm0 4a5 5 0 0 1 5 5h2.5A7.5 7.5 0 0 0 4 12.5V15zm1.75 5a1.75 1.75 0 1 0 0-3.5 1.75 1.75 0 0 0 0 3.5z\" data-kid=\"349\"></path></svg></a>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"finefoot\" data-kid=\"350\">\n      <div data-kid=\"351\">© 2025 Little Orrery Press · all illustrations hand-painted, never gradient-rendered</div>\n      <div class=\"legal\" data-kid=\"352\"><a href=\"#\" data-kid=\"353\">Privacy</a><a href=\"#\" data-kid=\"354\">Terms</a><a href=\"#\" data-kid=\"355\">Accessibility</a></div>\n    </div>\n  </div>\n</footer>\n\n<script data-kid=\"356\">\n(function(){\n  const reduce = false;\n  var isTouch = window.matchMedia('(hover: none)').matches || ('ontouchstart' in window);\n\n  /* ---- Hero entrance reveal ---- */\n  var hero = document.getElementById('hero');\n  var heroVideo = document.getElementById('heroVideo');\n  function revealHero(){ if(hero) hero.classList.add('is-in'); }\n  requestAnimationFrame(function(){ requestAnimationFrame(revealHero); });\n  window.addEventListener('load', revealHero);\n\n  /* ---- Fade the cosmos video in over the CSS fallback once it can play ---- */\n  if(heroVideo){\n    var showVideo = function(){ heroVideo.classList.add('ready'); };\n    if(heroVideo.readyState >= 3) showVideo();\n    heroVideo.addEventListener('canplay', showVideo, {once:true});\n    heroVideo.addEventListener('loadeddata', showVideo, {once:true});\n    // if the asset is missing, leave the animated fallback in place\n    heroVideo.addEventListener('error', function(){ heroVideo.classList.remove('ready'); });\n    var src = heroVideo.querySelector('source');\n    if(src) src.addEventListener('error', function(){ heroVideo.classList.remove('ready'); });\n    var play = heroVideo.play && heroVideo.play();\n    if(play && play.catch) play.catch(function(){});\n  }\n\n  /* ---- Catalog grid 3D tilt toward cursor ---- */\n  var bookgrid = document.getElementById('bookgrid');\n  var books = bookgrid ? bookgrid.querySelectorAll('.book') : [];\n  if(bookgrid && !isTouch && !reduce){\n    var gmx=0,gmy=0;\n    bookgrid.addEventListener('mousemove', function(e){\n      var r = bookgrid.getBoundingClientRect();\n      gmx = ((e.clientX - r.left)/r.width - .5);\n      gmy = ((e.clientY - r.top)/r.height - .5);\n      books.forEach(function(b){ b.style.setProperty('--mx', gmx); b.style.setProperty('--my', gmy); });\n    });\n    bookgrid.addEventListener('mouseleave', function(){\n      books.forEach(function(b){ b.style.setProperty('--mx', 0); b.style.setProperty('--my', 0); });\n    });\n  }\n\n  /* ---- Filter pills ---- */\n  document.querySelectorAll('.pill').forEach(function(p){\n    p.addEventListener('click', function(){\n      document.querySelectorAll('.pill').forEach(function(x){ x.classList.remove('active'); });\n      p.classList.add('active');\n    });\n  });\n\n  /* ---- Count-up ---- */\n  var joinNum = document.getElementById('joinNum');\n  function countUp(el){\n    var target = +el.getAttribute('data-target'), start=null, dur=1600;\n    function step(ts){\n      if(!start) start=ts;\n      var p = Math.min(1,(ts-start)/dur);\n      var v = Math.floor((1-Math.pow(1-p,3))*target);\n      el.textContent = v.toLocaleString('en-US');\n      if(p<1) requestAnimationFrame(step);\n    }\n    requestAnimationFrame(step);\n  }\n\n  /* ---- IntersectionObserver entrances ---- */\n  var io = new IntersectionObserver(function(entries){\n    entries.forEach(function(en){\n      if(!en.isIntersecting) return;\n      var t = en.target;\n      if(t.id==='catHead'||t.id==='evHead') t.classList.add('is-in');\n      else if(t.classList.contains('book')) t.classList.add('rise');\n      else if(t.classList.contains('ev')) t.classList.add('rise');\n      else if(t.id==='joinNum'){ if(!reduce) countUp(t); else t.textContent='84,000'; }\n      else t.classList.add('rise');\n      io.unobserve(t);\n    });\n  }, {threshold:0.12, rootMargin:'0px 0px -8% 0px'});\n  ['catHead','evHead','newsBlock','footCols','joinNum'].forEach(function(id){ var e=document.getElementById(id); if(e) io.observe(e); });\n  books.forEach(function(b,i){ b.style.transitionDelay=(i*0.08)+'s'; io.observe(b); });\n  document.querySelectorAll('.ev').forEach(function(e,i){ e.style.transitionDelay=(i*0.1)+'s'; io.observe(e); });\n  if(reduce && joinNum) joinNum.textContent='84,000';\n\n  /* ---- Classroom sticky-stack scale + lock ---- */\n  var outer = document.getElementById('classroomOuter');\n  var panels = outer ? Array.prototype.slice.call(outer.querySelectorAll('.panel')) : [];\n  var mobileStack = window.matchMedia('(max-width:768px)').matches;\n  if(mobileStack){\n    panels.forEach(function(p){ p.classList.add('locked'); });\n  }\n\n  /* ---- One rAF scroll loop ---- */\n  var sy = window.scrollY, ticking=false;\n  var spine = document.getElementById('spine');\n  var thread = document.getElementById('thread');\n  var fshapes = document.querySelectorAll('.fshape');\n  var footer = document.querySelector('footer');\n  var catalog = document.getElementById('catalog');\n  var heroInner = document.querySelector('.hero-inner');\n\n  function update(){\n    var vh = window.innerHeight;\n\n    // hero scroll choreography — the cosmos video slow-zooms as the title\n    // parts and fades, handing focus to the catalog below\n    var hp = Math.min(1, Math.max(0, sy/(vh*0.9))); // 0..1 across the first screen\n    if(!reduce){\n      if(heroVideo) heroVideo.style.transform = 'translateY('+(hp*-40)+'px) scale('+(1 + hp*0.12)+')';\n      if(heroInner){ heroInner.style.transform = 'translateY('+(hp*-46)+'px)'; heroInner.style.opacity = (1 - hp*1.05); }\n    }\n\n    // catalog z-separation on scroll\n    if(catalog && !reduce && !mobileStack){\n      var cr = catalog.getBoundingClientRect();\n      var cp = Math.min(1, Math.max(0, 1 - (cr.top / vh)));\n      books.forEach(function(b,i){ b.style.setProperty('--zsep', (cp*(i%3)*22)+'px'); });\n    }\n\n    // classroom sticky-stack\n    if(outer && !mobileStack){\n      var orect = outer.getBoundingClientRect();\n      var total = outer.offsetHeight - vh;\n      var p = Math.min(1, Math.max(0, (-orect.top)/total)); // 0..1 over whole section\n      var seg = 1/panels.length;\n      panels.forEach(function(panel,i){\n        // each panel \"active\" window\n        var pStart = i*seg;\n        var local = (p - pStart)/seg; // progress while this panel is on top\n        if(local > 0.05 && local < 1.05){\n          panel.classList.add('locked');\n        }\n        // scale previous panels down as next covers them\n        if(i < panels.length-1){\n          var nextProg = Math.min(1, Math.max(0, (p - (i+1)*seg + seg)/seg));\n          var sc = 1 - nextProg*0.04;\n          panel.style.transform = 'scale('+sc+')';\n        }\n      });\n      // ensure first panel locks immediately when in view\n      if(p < 0.05) panels[0].classList.add('locked');\n    }\n\n    // events spine draw\n    if(thread && spine && !reduce){\n      var tr = thread.getBoundingClientRect();\n      var tp = Math.min(1, Math.max(0, (vh*0.85 - tr.top)/(tr.height*0.85)));\n      spine.style.transform = 'scaleY('+tp+')';\n      // portrait parallax\n      document.querySelectorAll('.who2').forEach(function(w){\n        var wr = w.getBoundingClientRect();\n        var off = (wr.top - vh/2)*-0.04;\n        w.style.transform = 'translateY('+off+'px)';\n      });\n    }\n\n    // footer shape parallax\n    if(footer && !reduce){\n      var fr = footer.getBoundingClientRect();\n      fshapes.forEach(function(s){\n        var d = +s.getAttribute('data-depth')||0;\n        s.style.transform = 'translateY('+((vh-fr.top)/vh*d)+'px)';\n      });\n    }\n\n    ticking=false;\n  }\n  function onScroll(){ sy = window.scrollY; if(!ticking){ requestAnimationFrame(update); ticking=true; } }\n  window.addEventListener('scroll', onScroll, {passive:true});\n  window.addEventListener('resize', function(){ mobileStack = window.matchMedia('(max-width:768px)').matches; onScroll(); }, {passive:true});\n  update();\n})();\n</script>\n",
