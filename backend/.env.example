# Supabase: Project Settings -> Database -> Connection string.
# DATABASE_URL = "Transaction" pooler (port 6543) - used by the app at runtime.
# DIRECT_URL   = "Session"/direct connection (port 5432) - used by Prisma for migrations.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.xxxxxxxxxxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
CORS_ORIGINS=http://localhost:5173
UPLOAD_DIR=uploads
PORT=8000
